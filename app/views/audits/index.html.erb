<% content_for :page_title, "Audit log" %>
<% content_for :page_description, "#{@total} recorded change#{'s' unless @total == 1} across the workspace" %>

<div class="card mb-5 p-4">
  <%= form_with url: audits_path, method: :get, class: "grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-6",
                data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
    <div class="lg:col-span-2">
      <label class="label">Search</label>
      <%= text_field_tag :q, params[:q], class: "input", placeholder: "Record or person" %>
    </div>
    <div>
      <label class="label">Type</label>
      <%= select_tag :type, options_for_select(@types.map { |t| [t.underscore.humanize, t] }, params[:type]),
                     include_blank: "All", class: "input" %>
    </div>
    <div>
      <label class="label">Action</label>
      <%= select_tag :action_type, options_for_select(Audit::ACTIONS.map { |a| [a.humanize, a] }, params[:action_type]),
                     include_blank: "All", class: "input" %>
    </div>
    <div>
      <label class="label">Person</label>
      <%= select_tag :user_id, options_for_select(@actors.map { |u| [u.display_name, u.id] }, params[:user_id]),
                     include_blank: "Anyone", class: "input" %>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <div>
        <label class="label">From</label>
        <%= date_field_tag :from, params[:from], class: "input" %>
      </div>
      <div>
        <label class="label">To</label>
        <%= date_field_tag :to, params[:to], class: "input" %>
      </div>
    </div>
  <% end %>
  <% if params.values_at(:q, :type, :action_type, :user_id, :from, :to, :record_id).any?(&:present?) %>
    <div class="mt-3">
      <%= link_to "Clear filters", audits_path, class: "text-xs font-semibold text-accent-700 hover:text-accent-900" %>
    </div>
  <% end %>
</div>

<div class="card overflow-hidden">
  <ul class="divide-y divide-ink-100">
    <%= render partial: "audits/audit", collection: @audits %>
    <% if @audits.empty? %>
      <li class="px-4 py-10 text-center text-sm text-ink-400">No changes match these filters.</li>
    <% end %>
  </ul>
</div>

<% if @last_page > 1 %>
  <div class="mt-4 flex items-center justify-between text-sm">
    <span class="text-xs text-ink-500">Page <%= @page %> of <%= @last_page %></span>
    <div class="flex gap-2">
      <% if @page > 1 %>
        <%= link_to "← Newer", audits_path(request.query_parameters.merge(page: @page - 1)), class: "btn-secondary" %>
      <% end %>
      <% if @page < @last_page %>
        <%= link_to "Older →", audits_path(request.query_parameters.merge(page: @page + 1)), class: "btn-secondary" %>
      <% end %>
    </div>
  </div>
<% end %>
