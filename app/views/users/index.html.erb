<% content_for :page_title, "Accounts" %>
<% content_for :page_description, "Create team leads and manage login roles" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-wrap gap-2">
    <%= link_to "All", accounts_path, class: params[:role].blank? ? "chip-active" : "chip" %>
    <% User.roles.keys.each do |role| %>
      <%= link_to role.humanize, accounts_path(role: role), class: params[:role] == role ? "chip-active" : "chip" %>
    <% end %>
  </div>
  <%= link_to "+ Add team lead / user", new_account_path, class: "btn-primary" %>
</div>

<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[720px]">
      <thead class="bg-ink-50/80">
        <tr>
          <th class="table-head">Name</th>
          <th class="table-head">Email</th>
          <th class="table-head">Role</th>
          <th class="table-head">Linked developer</th>
          <th class="table-head">Team size</th>
          <th class="table-head"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-100 bg-white/50">
        <% @users.each do |user| %>
          <tr class="transition hover:bg-accent-50/40">
            <td class="table-cell font-medium text-ink-950">
              <div class="flex items-center gap-2.5">
                <%= initials_avatar(user.display_name) %>
                <%= user.display_name %>
                <% if user == current_user %><span class="text-[10px] font-semibold uppercase text-accent-700">You</span><% end %>
              </div>
            </td>
            <td class="table-cell text-ink-500"><%= user.email %></td>
            <td class="table-cell"><span class="badge bg-ink-100 text-ink-700 ring-1 ring-ink-200"><%= user.role.humanize %></span></td>
            <td class="table-cell">
              <% if user.developer %>
                <%= link_to user.developer.name, user.developer, class: "font-medium text-accent-700 hover:underline" %>
              <% else %>
                <span class="text-ink-400">—</span>
              <% end %>
            </td>
            <td class="table-cell"><%= user.team_lead? ? user.team_developers.count : "—" %></td>
            <td class="table-cell text-right space-x-2">
              <%= link_to "Edit", edit_account_path(user), class: "text-xs font-semibold text-accent-700 hover:text-accent-900" %>
              <% if user.team_lead? && user != current_user %>
                <%= button_to "Demote", demote_account_path(user), method: :post, class: "inline text-xs font-semibold text-amber-700 hover:text-amber-900", form: { data: { turbo_confirm: "Demote #{user.display_name} to developer? Their team will be unassigned." }, class: "inline" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
