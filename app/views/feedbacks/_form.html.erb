<%= form_with model: feedback, url: (feedback.persisted? ? feedback_path(feedback) : (@developer ? developer_feedbacks_path(@developer) : feedbacks_path)), class: "space-y-5" do |f| %>
  <% if feedback.errors.any? %>
    <div class="rounded-md bg-red-50 p-3 text-sm text-red-700">
      <ul class="list-disc pl-4">
        <% feedback.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <% if @developer %>
      <%= f.hidden_field :developer_id, value: @developer.id %>
      <div class="sm:col-span-2">
        <p class="label">Developer</p>
        <p class="text-sm font-medium text-ink-900"><%= @developer.name %></p>
      </div>
    <% else %>
      <div>
        <%= f.label :developer_id, "Developer", class: "label" %>
        <%= f.collection_select :developer_id, scoped_developers.order(:name), :id, :name, { include_blank: "Select…" }, class: "input", required: true %>
      </div>
    <% end %>
    <div>
      <%= f.label :feedback_date, "Date", class: "label" %>
      <%= f.date_field :feedback_date, class: "input" %>
    </div>
    <div class="sm:col-span-2">
      <%= f.label :title, class: "label" %>
      <%= f.text_field :title, class: "input", placeholder: "e.g. Strong delivery on Novatro sprint" %>
    </div>
    <div>
      <%= f.label :rating, class: "label" %>
      <%= f.select :rating, (1..5).map { |n| ["★" * n + " (#{n})", n] }, {}, class: "input" %>
    </div>
  </div>

  <div>
    <%= f.label :body, "Notes", class: "label" %>
    <%= f.text_area :body, rows: 5, class: "input", placeholder: "What went well, what to improve…" %>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", (@developer ? developer_path(@developer) : feedbacks_path), class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
