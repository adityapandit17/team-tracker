<% content_for :page_title, @feedback.title %>
<% content_for :page_description, "#{@feedback.developer.name} · Feedback" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <%= link_to "← All feedback", feedbacks_path, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
  <div class="flex flex-wrap gap-2">
    <% if can?(:manage_feedback) && (can?(:manage_all_records) || owns_record?(@feedback)) %>
      <%= link_to "Edit", edit_feedback_path(@feedback), class: "btn-secondary" %>
      <%= button_to "Delete", feedback_path(@feedback), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Delete this feedback?" } } %>
    <% end %>
  </div>
</div>

<div class="mx-auto max-w-2xl">
  <article class="card p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-400"><%= link_to @feedback.developer.name, @feedback.developer, class: "hover:text-accent-700" %></p>
        <h2 class="mt-1 font-display text-2xl font-semibold text-ink-950"><%= @feedback.title %></h2>
      </div>
      <%= rating_stars(@feedback.rating) %>
    </div>
    <div class="mt-4 text-xs text-ink-400">
      By <%= @feedback.author.display_name %> · <%= l(@feedback.feedback_date) %>
    </div>
    <div class="mt-6 whitespace-pre-wrap text-sm leading-relaxed text-ink-700"><%= @feedback.body.presence || "No notes provided." %></div>
  </article>
</div>
