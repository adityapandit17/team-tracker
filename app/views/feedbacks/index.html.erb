<% content_for :page_title, @developer ? "#{@developer.name} — Feedback" : "Feedback" %>
<% content_for :page_description, "Ratings and written feedback for developers" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-wrap items-center gap-2">
    <% if @developer %>
      <%= link_to "← #{@developer.name}", @developer, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
    <% else %>
      <%= link_to "All", feedbacks_path(view: @view), class: params[:developer_filter].blank? ? "chip-active" : "chip" %>
      <% if can?(:manage_feedback) || can?(:view_all_records) %>
        <%= form_with url: feedbacks_path, method: :get, class: "inline", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
          <%= hidden_field_tag :view, @view %>
          <%= select_tag :developer_filter,
                options_from_collection_for_select(scoped_developers.order(:name), :id, :name, params[:developer_filter]),
                include_blank: "Filter developer",
                class: "input !w-auto !py-1.5 text-xs" %>
        <% end %>
      <% end %>
    <% end %>
    <div class="flex rounded-lg border border-ink-200 bg-white/80 p-0.5">
      <%= link_to "Grid", (@developer ? developer_feedbacks_path(@developer, view: "grid") : feedbacks_path(view: "grid", developer_filter: params[:developer_filter])),
            class: "rounded-md px-3 py-1 text-xs font-semibold #{@view == 'grid' ? 'bg-ink-950 text-sand-50' : 'text-ink-600'}" %>
      <%= link_to "Cards", (@developer ? developer_feedbacks_path(@developer, view: "kanban") : feedbacks_path(view: "kanban", developer_filter: params[:developer_filter])),
            class: "rounded-md px-3 py-1 text-xs font-semibold #{@view == 'kanban' ? 'bg-ink-950 text-sand-50' : 'text-ink-600'}" %>
    </div>
  </div>
  <% if can?(:manage_feedback) %>
    <%= link_to "+ Add Feedback",
          (@developer ? new_developer_feedback_path(@developer) : new_feedback_path),
          class: "btn-primary" %>
  <% end %>
</div>

<% if @view == "kanban" %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <% @feedbacks.each do |fb| %>
      <article class="card p-5 transition hover:border-accent-200">
        <div class="flex items-start justify-between gap-3">
          <div>
            <% unless @developer %>
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-400"><%= fb.developer.name %></p>
            <% end %>
            <h3 class="mt-1 font-display text-lg font-semibold text-ink-950"><%= link_to fb.title, fb, class: "hover:text-accent-700" %></h3>
          </div>
          <%= rating_stars(fb.rating) %>
        </div>
        <p class="mt-3 line-clamp-3 text-sm text-ink-600"><%= fb.body.presence || "No notes." %></p>
        <div class="mt-4 flex items-center justify-between text-xs text-ink-400">
          <span><%= fb.author.display_name %> · <%= l(fb.feedback_date) %></span>
          <% if can?(:manage_feedback) && (can?(:manage_all_records) || owns_record?(fb)) %>
            <%= link_to "Edit", edit_feedback_path(fb), class: "font-semibold text-accent-700" %>
          <% end %>
        </div>
      </article>
    <% end %>
    <% if @feedbacks.empty? %>
      <div class="card col-span-full p-10 text-center text-ink-400">No feedback yet.</div>
    <% end %>
  </div>
<% else %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[720px]">
        <thead class="bg-ink-50/80">
          <tr>
            <% unless @developer %><th class="table-head">Developer</th><% end %>
            <th class="table-head">Title</th>
            <th class="table-head">Rating</th>
            <th class="table-head">Author</th>
            <th class="table-head">Date</th>
            <th class="table-head"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100 bg-white/50">
          <% @feedbacks.each do |fb| %>
            <tr class="transition hover:bg-accent-50/40">
              <% unless @developer %>
                <td class="table-cell font-medium"><%= link_to fb.developer.name, fb.developer, class: "hover:text-accent-700" %></td>
              <% end %>
              <td class="table-cell font-medium text-ink-950"><%= link_to fb.title, fb, class: "hover:text-accent-700" %></td>
              <td class="table-cell"><%= rating_stars(fb.rating) %></td>
              <td class="table-cell text-ink-500"><%= fb.author.display_name %></td>
              <td class="table-cell text-ink-500"><%= l(fb.feedback_date) %></td>
              <td class="table-cell text-right">
                <% if can?(:manage_feedback) && (can?(:manage_all_records) || owns_record?(fb)) %>
                  <%= link_to "Edit", edit_feedback_path(fb), class: "text-xs font-semibold text-accent-700" %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @feedbacks.empty? %>
            <tr><td colspan="6" class="table-cell py-10 text-center text-ink-400">No feedback yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
