<% content_for :page_title, @developer ? "#{@developer.name} — Assessments" : "Assessments" %>
<% content_for :page_description, "Career-level assessments with criteria ratings" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-wrap items-center gap-2">
    <% if @developer %>
      <%= link_to "← #{@developer.name}", @developer, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
    <% else %>
      <%= link_to "All", assessments_path(view: @view), class: params[:career_level].blank? ? "chip-active" : "chip" %>
      <% Assessment.career_levels.keys.each do |level| %>
        <%= link_to level.humanize, assessments_path(view: @view, career_level: level, developer_filter: params[:developer_filter]),
              class: params[:career_level] == level ? "chip-active" : "chip" %>
      <% end %>
    <% end %>
    <div class="flex rounded-lg border border-ink-200 bg-white/80 p-0.5">
      <%= link_to "Grid", (@developer ? developer_assessments_path(@developer, view: "grid") : assessments_path(view: "grid", career_level: params[:career_level])),
            class: "rounded-md px-3 py-1 text-xs font-semibold #{@view == 'grid' ? 'bg-ink-950 text-sand-50' : 'text-ink-600'}" %>
      <%= link_to "Cards", (@developer ? developer_assessments_path(@developer, view: "kanban") : assessments_path(view: "kanban", career_level: params[:career_level])),
            class: "rounded-md px-3 py-1 text-xs font-semibold #{@view == 'kanban' ? 'bg-ink-950 text-sand-50' : 'text-ink-600'}" %>
    </div>
  </div>
  <% if can?(:manage_assessments) %>
    <%= link_to "+ New Assessment",
          (@developer ? new_developer_assessment_path(@developer) : new_assessment_path),
          class: "btn-primary" %>
  <% end %>
</div>

<% if @view == "kanban" %>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <% @assessments.each do |assessment| %>
      <article class="card p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <% unless @developer %>
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-400"><%= assessment.developer.name %></p>
            <% end %>
            <h3 class="mt-1 font-display text-lg font-semibold text-ink-950"><%= link_to assessment.title, assessment, class: "hover:text-accent-700" %></h3>
          </div>
          <%= status_badge(assessment.career_level) %>
        </div>
        <div class="mt-3 flex items-center gap-3">
          <%= rating_stars(assessment.overall_rating) %>
          <span class="text-xs text-ink-400"><%= l(assessment.assessed_on) %></span>
        </div>
        <ul class="mt-4 space-y-1.5">
          <% assessment.assessment_criteria.each do |c| %>
            <li class="flex items-center justify-between rounded-lg bg-ink-50/80 px-2.5 py-1.5 text-xs">
              <span class="font-medium text-ink-700"><%= c.name %></span>
              <span class="font-semibold text-ink-900"><%= c.rating %>/5</span>
            </li>
          <% end %>
        </ul>
      </article>
    <% end %>
    <% if @assessments.empty? %>
      <div class="card col-span-full p-10 text-center text-ink-400">No assessments yet.</div>
    <% end %>
  </div>
<% else %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[800px]">
        <thead class="bg-ink-50/80">
          <tr>
            <% unless @developer %><th class="table-head">Developer</th><% end %>
            <th class="table-head">Title</th>
            <th class="table-head">Level</th>
            <th class="table-head">Overall</th>
            <th class="table-head">Assessed</th>
            <th class="table-head">Author</th>
            <th class="table-head"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100 bg-white/50">
          <% @assessments.each do |assessment| %>
            <tr class="transition hover:bg-accent-50/40">
              <% unless @developer %>
                <td class="table-cell font-medium"><%= link_to assessment.developer.name, assessment.developer, class: "hover:text-accent-700" %></td>
              <% end %>
              <td class="table-cell font-medium text-ink-950"><%= link_to assessment.title, assessment, class: "hover:text-accent-700" %></td>
              <td class="table-cell"><%= status_badge(assessment.career_level) %></td>
              <td class="table-cell"><%= rating_stars(assessment.overall_rating) %></td>
              <td class="table-cell text-ink-500"><%= l(assessment.assessed_on) %></td>
              <td class="table-cell text-ink-500"><%= assessment.author.display_name %></td>
              <td class="table-cell text-right">
                <% if can?(:manage_assessments) && (can?(:manage_all_records) || owns_record?(assessment)) %>
                  <%= link_to "Edit", edit_assessment_path(assessment), class: "text-xs font-semibold text-accent-700" %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @assessments.empty? %>
            <tr><td colspan="7" class="table-cell py-10 text-center text-ink-400">No assessments yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
