<% content_for :page_title, @assessment.title %>
<% content_for :page_description, "#{@assessment.developer.name} · #{@assessment.career_level.humanize} assessment" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <%= link_to "← All assessments", assessments_path, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
  <div class="flex flex-wrap gap-2">
    <% if can?(:manage_assessments) && (can?(:manage_all_records) || owns_record?(@assessment)) %>
      <%= link_to "Edit", edit_assessment_path(@assessment), class: "btn-secondary" %>
      <%= button_to "Delete", assessment_path(@assessment), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Delete this assessment?" } } %>
    <% end %>
  </div>
</div>

<div class="mx-auto max-w-3xl space-y-4">
  <article class="card p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-400"><%= link_to @assessment.developer.name, @assessment.developer, class: "hover:text-accent-700" %></p>
        <h2 class="mt-1 font-display text-2xl font-semibold text-ink-950"><%= @assessment.title %></h2>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <%= status_badge(@assessment.career_level) %>
          <span class="text-xs text-ink-400"><%= l(@assessment.assessed_on) %> · <%= @assessment.author.display_name %></span>
        </div>
      </div>
      <div class="text-right">
        <p class="text-[11px] font-semibold uppercase tracking-wide text-ink-400">Overall</p>
        <%= rating_stars(@assessment.overall_rating) %>
      </div>
    </div>
    <% if @assessment.summary.present? %>
      <p class="mt-5 text-sm leading-relaxed text-ink-700"><%= @assessment.summary %></p>
    <% end %>
  </article>

  <section class="card overflow-hidden">
    <div class="border-b border-ink-100 bg-ink-50/80 px-5 py-3">
      <h3 class="text-sm font-semibold text-ink-900">Criteria</h3>
    </div>
    <ul class="divide-y divide-ink-100">
      <% @assessment.assessment_criteria.each do |c| %>
        <li class="flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-medium text-ink-900"><%= c.name %></p>
            <% if c.notes.present? %><p class="mt-0.5 text-xs text-ink-500"><%= c.notes %></p><% end %>
          </div>
          <div class="flex items-center gap-2">
            <div class="h-2 w-24 overflow-hidden rounded-full bg-ink-100">
              <div class="h-full rounded-full bg-accent-500" style="width: <%= (c.rating / 5.0) * 100 %>%"></div>
            </div>
            <span class="text-sm font-semibold text-ink-900"><%= c.rating %>/5</span>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
</div>
