<% content_for :page_title, "Client Leads" %>
<% content_for :page_description, "Sales / onboarding pipeline" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-wrap gap-2">
    <%= link_to "All", client_leads_path, class: params[:status].blank? ? "chip-active" : "chip" %>
    <% ClientLead.statuses.keys.each do |s| %>
      <%= link_to s.humanize, client_leads_path(status: s), class: params[:status] == s ? "chip-active" : "chip" %>
    <% end %>
  </div>
  <%= link_to "+ Add Lead", new_client_lead_path, class: "btn-primary" if can?(:manage_all_records) %>
</div>

<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[800px]">
      <thead class="bg-ink-50/80">
        <tr>
          <th class="table-head">Client</th>
          <th class="table-head">Assignee</th>
          <th class="table-head">Calls</th>
          <th class="table-head">Tests</th>
          <th class="table-head">Rounds</th>
          <th class="table-head">Status</th>
          <th class="table-head">Remarks</th>
          <th class="table-head"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-100 bg-white/50">
        <% @client_leads.each do |cl| %>
          <tr class="transition hover:bg-accent-50/40">
            <td class="table-cell font-medium text-ink-950"><%= cl.client_name %></td>
            <td class="table-cell"><%= cl.assignee&.name || "—" %></td>
            <td class="table-cell text-ink-500"><%= cl.calls.presence || "—" %></td>
            <td class="table-cell text-ink-500"><%= cl.tests.presence || "—" %></td>
            <td class="table-cell"><%= cl.rounds %></td>
            <td class="table-cell"><%= status_badge(cl.status) %></td>
            <td class="table-cell max-w-xs truncate text-ink-500"><%= cl.remarks %></td>
            <td class="table-cell text-right">
              <% if can?(:manage_all_records) || (can?(:edit_own_leads) && owns_record?(cl)) %>
                <%= link_to "Edit", edit_client_lead_path(cl), class: "text-xs font-semibold text-accent-700 hover:text-accent-900" %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @client_leads.empty? %>
          <tr><td colspan="8" class="table-cell py-10 text-center text-ink-400">No leads match this filter.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
