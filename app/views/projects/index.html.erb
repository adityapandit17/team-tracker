<% content_for :page_title, "Projects" %>
<% content_for :page_description, can?(:edit_own_projects) ? "#{@projects.size} shown · edit any cell to save instantly" : "#{@projects.size} shown" %>

<div data-controller="table-columns" data-table-columns-storage-key-value="projects-table-columns">
  <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-wrap gap-2">
      <%= link_to "All", projects_path, class: params[:status].blank? && params[:billing_type].blank? ? "chip-active" : "chip" %>
      <% Project.statuses.keys.each do |s| %>
        <%= link_to s.humanize, projects_path(status: s), class: params[:status] == s ? "chip-active" : "chip" %>
      <% end %>
      <%= link_to "Monthly", projects_path(billing_type: "monthly"), class: params[:billing_type] == "monthly" ? "chip-active" : "chip" %>
      <%= link_to "Fixed", projects_path(billing_type: "fixed_price"), class: params[:billing_type] == "fixed_price" ? "chip-active" : "chip" %>
    </div>

    <div class="flex gap-2">
      <div class="relative" data-controller="dropdown">
        <button type="button" class="btn-secondary" aria-haspopup="true" aria-expanded="false"
                data-dropdown-target="trigger" data-action="dropdown#toggle">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="opacity-80">
            <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><path d="M15 4v16"/>
          </svg>
          Columns
          <span class="ml-1 rounded-full bg-ink-100 px-2 py-0.5 text-[11px] font-semibold text-ink-600"
                data-table-columns-target="count">All</span>
        </button>

        <div class="card absolute right-0 z-30 mt-2 hidden w-60 p-3 shadow-soft" data-dropdown-target="content">
          <div class="flex items-center justify-between px-1 pb-2">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-ink-500">Visible columns</span>
            <button type="button" class="text-[11px] font-semibold text-accent-700 hover:text-accent-900"
                    data-action="table-columns#showAll">Show all</button>
          </div>
          <div class="max-h-72 space-y-0.5 overflow-y-auto">
            <% project_table_columns.each do |column| %>
              <label class="flex items-center gap-2 rounded-lg px-1.5 py-1.5 text-sm text-ink-700 <%= column[:locked] ? "opacity-50" : "hover:bg-ink-50" %>">
                <input type="checkbox" checked
                       class="rounded border-ink-300 text-accent-600 focus:ring-accent-500 disabled:opacity-60"
                       data-column-key="<%= column[:key] %>"
                       data-table-columns-target="checkbox"
                       data-action="change->table-columns#toggle"
                       <%= "disabled" if column[:locked] %>>
                <%= column[:label] %>
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <% if can?(:view_billings) %>
        <%= link_to "Billing overview", billings_path, class: "btn-secondary" %>
      <% end %>
      <%= link_to "+ Add Project", new_project_path, class: "btn-primary" if can?(:manage_all_records) %>
    </div>
  </div>

  <div id="projects-inline-flash"></div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-ink-50/80">
          <tr>
            <% project_table_columns.each do |column| %>
              <th class="table-head whitespace-nowrap" data-column="<%= column[:key] %>">
                <%= column.fetch(:header, column[:label]) %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100 bg-white/50">
          <%= render partial: "projects/row", collection: @projects, as: :project %>
          <% if @projects.empty? %>
            <tr><td colspan="<%= project_table_columns.size %>" class="table-cell py-10 text-center text-ink-400">No projects match this filter.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if can?(:edit_own_projects) %>
  <p class="mt-3 text-xs text-ink-400">
    Changes save as soon as you pick a value or leave a text field — no page reload.
  </p>
<% end %>
