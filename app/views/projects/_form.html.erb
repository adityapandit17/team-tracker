<%= form_with model: project, class: "space-y-5", data: { controller: "billing-type" } do |f| %>
  <% if project.errors.any? %>
    <div class="rounded-md bg-red-50 p-3 text-sm text-red-700">
      <ul class="list-disc pl-4">
        <% project.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <% if can?(:manage_all_records) %>
      <div>
        <%= f.label :name, class: "label" %>
        <%= f.text_field :name, class: "input" %>
      </div>
      <div>
        <%= f.label :technology, class: "label" %>
        <%= f.text_field :technology, class: "input", placeholder: "e.g. ROR, MERN, ROR + React" %>
      </div>
      <div>
        <%= f.label :start_date, class: "label" %>
        <%= f.date_field :start_date, class: "input" %>
      </div>
      <div>
        <%= f.label :billing_type, class: "label" %>
        <%= f.select :billing_type, Project.billing_types.keys.map { |t| [t.humanize, t] }, {}, class: "input", data: { action: "change->billing-type#toggle", billing_type_target: "select" } %>
      </div>
      <div data-billing-type-target="fixedAmount" class="<%= "hidden" unless project.fixed_price? %>">
        <%= f.label :fixed_amount, "Fixed price (₹)", class: "label" %>
        <%= f.number_field :fixed_amount, step: 0.01, min: 0, class: "input" %>
      </div>
      <div>
        <%= f.label :hourly_rate, "Hourly rate (₹)", class: "label" %>
        <%= f.number_field :hourly_rate, step: 1, min: 0, class: "input", placeholder: "Client bill rate" %>
      </div>
    <% end %>
    <div>
      <%= f.label :status, class: "label" %>
      <%= f.select :status, Project.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "input" %>
    </div>
    <% if can?(:manage_all_records) %>
      <div>
        <%= f.label :call_developer_id, "On calls", class: "label" %>
        <%= f.collection_select :call_developer_id, Developer.order(:name), :id, :name, { include_blank: "—" }, class: "input" %>
      </div>
      <div>
        <%= f.label :main_developer_id, "Main developer", class: "label" %>
        <%= f.collection_select :main_developer_id, Developer.order(:name), :id, :name, { include_blank: "—" }, class: "input" %>
      </div>
      <div>
        <%= f.label :helper_developer_id, "Helper", class: "label" %>
        <%= f.collection_select :helper_developer_id, Developer.order(:name), :id, :name, { include_blank: "—" }, class: "input" %>
      </div>
      <div>
        <%= f.label :lead_developer_id, "Project lead", class: "label" %>
        <%= f.collection_select :lead_developer_id, Developer.order(:name), :id, :name, { include_blank: "—" }, class: "input" %>
        <p class="mt-1 text-xs text-ink-400">Member responsible as lead — used for incentive count.</p>
      </div>
      <div class="flex items-center gap-2 pt-6 sm:col-span-2">
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <%= f.check_box :incentive_eligible, class: "rounded border-slate-300 text-primary-600 focus:ring-primary-500" %>
          Eligible for lead incentive
        </label>
      </div>
    <% end %>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", projects_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
