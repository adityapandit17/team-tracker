<% notice_text = local_assigns[:notice] %>
<% alert_text = local_assigns[:alert] %>
<% if alert_text.present? %>
  <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
    <%= alert_text %>
  </div>
<% elsif notice_text.present? %>
  <div class="mb-4 flex items-start gap-3 rounded-xl border border-accent-200 bg-accent-50 px-4 py-3 text-sm text-accent-900"
       role="status" data-controller="auto-dismiss">
    <span class="mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent-600 text-[10px] font-bold text-white">✓</span>
    <span><%= notice_text %></span>
  </div>
<% end %>
