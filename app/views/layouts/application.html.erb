<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title>Team Tracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#151b18">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full" data-controller="mobile-nav">
    <div class="flex min-h-screen">
      <%= render "shared/sidebar" %>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex h-16 items-center justify-between gap-4 border-b border-ink-200/60 bg-white/70 px-4 backdrop-blur-md sm:px-6">
          <div class="flex min-w-0 items-center gap-3">
            <button type="button"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-ink-200 bg-white text-ink-700 md:hidden"
                    data-action="mobile-nav#open"
                    aria-label="Open navigation">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <div class="min-w-0">
              <h1 class="truncate font-display text-xl font-semibold tracking-tight text-ink-950"><%= yield :page_title %></h1>
              <p class="truncate text-xs text-ink-500"><%= yield :page_description %></p>
            </div>
          </div>
          <div class="hidden items-center gap-2 sm:flex">
            <% if user_signed_in? %>
              <span class="chip"><%= current_user.role.humanize %></span>
              <% if current_user.scoped? %>
                <span class="chip">My data</span>
              <% else %>
                <span class="chip">Ops workspace</span>
              <% end %>
            <% end %>
          </div>
        </header>

        <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
          <% if notice %>
            <div class="mb-4 flex items-start gap-3 rounded-xl border border-accent-200 bg-accent-50 px-4 py-3 text-sm text-accent-900" role="status">
              <span class="mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-accent-600 text-[10px] font-bold text-white">✓</span>
              <span><%= notice %></span>
            </div>
          <% end %>
          <% if alert %>
            <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
              <%= alert %>
            </div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    </div>

    <div class="fixed inset-0 z-40 hidden md:hidden" data-mobile-nav-target="overlay">
      <div class="absolute inset-0 bg-ink-950/40 backdrop-blur-sm" data-action="click->mobile-nav#close"></div>
      <aside class="absolute inset-y-0 left-0 flex w-72 flex-col border-r border-ink-200 bg-sand-50 shadow-soft">
        <div class="flex h-16 items-center justify-between border-b border-ink-200/70 px-4">
          <div class="flex items-center gap-2.5">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-ink-950 font-display text-sm font-bold text-sand-50">T</div>
            <span class="font-display text-lg font-semibold text-ink-950">Team Tracker</span>
          </div>
          <button type="button" class="btn-ghost h-8 w-8 p-0" data-action="mobile-nav#close" aria-label="Close navigation">✕</button>
        </div>
        <nav class="flex-1 space-y-1 p-3" data-action="click->mobile-nav#close">
          <%= render "shared/nav_links" %>
        </nav>
        <% if user_signed_in? %>
          <div class="border-t border-ink-200/70 p-4">
            <p class="truncate text-sm font-semibold text-ink-900"><%= current_user.display_name %></p>
            <p class="mb-2 text-[11px] font-semibold uppercase tracking-wide text-ink-400"><%= current_user.role.humanize %></p>
            <%= link_to "Account", edit_user_registration_path, class: "text-xs font-semibold text-accent-700" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "mt-1 block text-left text-xs font-semibold text-ink-500" %>
          </div>
        <% end %>
      </aside>
    </div>
  </body>
</html>
