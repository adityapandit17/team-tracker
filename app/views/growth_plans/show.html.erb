<% content_for :page_title, @growth_plan.title %>
<% content_for :page_description, "#{@growth_plan.developer.name} · Growth plan" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <%= link_to "← Growth plans", growth_plans_path, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
  <div class="flex flex-wrap gap-2">
    <% if can?(:manage_growth_plans) && (can?(:manage_all_records) || owns_record?(@growth_plan)) %>
      <%= link_to "Edit", edit_growth_plan_path(@growth_plan), class: "btn-secondary" %>
      <%= link_to "+ 1:1", new_developer_one_on_one_path(@growth_plan.developer, growth_plan_id: @growth_plan.id), class: "btn-primary" if can?(:manage_one_on_ones) %>
      <%= button_to "Delete", growth_plan_path(@growth_plan), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Delete this plan?" } } %>
    <% end %>
  </div>
</div>

<div class="mx-auto max-w-3xl space-y-4">
  <article class="card p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase text-ink-400"><%= link_to @growth_plan.developer.name, @growth_plan.developer, class: "hover:text-accent-700" %></p>
        <h2 class="mt-1 font-display text-2xl font-semibold text-ink-950"><%= @growth_plan.title %></h2>
        <div class="mt-2 flex flex-wrap gap-2">
          <%= status_badge(@growth_plan.status) %>
          <% if @growth_plan.target_career_level.present? %><%= status_badge(@growth_plan.target_career_level) %><% end %>
        </div>
      </div>
      <div class="text-right text-sm">
        <p class="text-[11px] font-semibold uppercase text-ink-400">Next review</p>
        <p class="font-medium <%= @growth_plan.overdue? ? 'text-red-600' : 'text-ink-900' %>">
          <%= @growth_plan.next_review_on ? l(@growth_plan.next_review_on) : "—" %>
        </p>
      </div>
    </div>
    <% if @growth_plan.assessment %>
      <p class="mt-4 text-sm text-ink-500">Baseline: <%= link_to @growth_plan.assessment.title, @growth_plan.assessment, class: "font-semibold text-accent-700" %></p>
    <% end %>
    <% if @growth_plan.goals.present? %>
      <div class="mt-5"><h3 class="text-sm font-semibold">Goals</h3><p class="mt-2 whitespace-pre-wrap text-sm text-ink-700"><%= @growth_plan.goals %></p></div>
    <% end %>
    <% if @growth_plan.focus_areas.present? %>
      <div class="mt-5"><h3 class="text-sm font-semibold">Focus areas</h3><p class="mt-2 whitespace-pre-wrap text-sm text-ink-700"><%= @growth_plan.focus_areas %></p></div>
    <% end %>
  </article>

  <section class="card p-6">
    <h3 class="font-display text-lg font-semibold">Recent 1:1s</h3>
    <% if @one_on_ones.any? %>
      <ul class="mt-3 space-y-2">
        <% @one_on_ones.each do |ooo| %>
          <li class="flex justify-between rounded-xl border border-ink-100 px-3 py-2 text-sm">
            <%= link_to l(ooo.meeting_on), ooo, class: "font-medium hover:text-accent-700" %>
            <%= status_badge(ooo.status) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-ink-400">No 1:1s linked to this plan.</p>
    <% end %>
  </section>

  <section class="card p-6">
    <h3 class="font-display text-lg font-semibold">Action items</h3>
    <% if @action_items.any? %>
      <ul class="mt-3 space-y-2">
        <% @action_items.each do |item| %>
          <li class="flex justify-between rounded-xl border border-ink-100 px-3 py-2 text-sm">
            <%= link_to item.title, item, class: "font-medium hover:text-accent-700" %>
            <%= status_badge(item.status) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-ink-400">No action items on this plan yet.</p>
    <% end %>
  </section>
</div>
