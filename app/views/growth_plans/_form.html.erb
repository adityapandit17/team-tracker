<%= form_with model: growth_plan, url: (growth_plan.persisted? ? growth_plan_path(growth_plan) : (@developer ? developer_growth_plans_path(@developer) : growth_plans_path)), class: "space-y-5" do |f| %>
  <% if growth_plan.errors.any? %>
    <div class="rounded-md bg-red-50 p-3 text-sm text-red-700">
      <ul class="list-disc pl-4"><% growth_plan.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <% if @developer %>
      <%= f.hidden_field :developer_id, value: @developer.id %>
      <div class="sm:col-span-2"><p class="label">Developer</p><p class="text-sm font-medium"><%= @developer.name %></p></div>
    <% else %>
      <div>
        <%= f.label :developer_id, class: "label" %>
        <%= f.collection_select :developer_id, scoped_developers.order(:name), :id, :name, { include_blank: "Select…" }, class: "input", required: true %>
      </div>
    <% end %>
    <div class="sm:col-span-2">
      <%= f.label :title, class: "label" %>
      <%= f.text_field :title, class: "input" %>
    </div>
    <div>
      <%= f.label :target_career_level, "Target level", class: "label" %>
      <%= f.select :target_career_level, Assessment.career_levels.keys.map { |l| [l.humanize, l] }, { include_blank: "—" }, class: "input" %>
    </div>
    <div>
      <%= f.label :status, class: "label" %>
      <%= f.select :status, GrowthPlan.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "input" %>
    </div>
    <div>
      <%= f.label :next_review_on, class: "label" %>
      <%= f.date_field :next_review_on, class: "input" %>
    </div>
    <div>
      <%= f.label :assessment_id, "Baseline assessment", class: "label" %>
      <%= f.collection_select :assessment_id,
            (@developer || growth_plan.developer) ? (@developer || growth_plan.developer).assessments.order(assessed_on: :desc) : Assessment.none,
            :id, :title, { include_blank: "—" }, class: "input" %>
    </div>
  </div>
  <div>
    <%= f.label :goals, class: "label" %>
    <%= f.text_area :goals, rows: 4, class: "input" %>
  </div>
  <div>
    <%= f.label :focus_areas, class: "label" %>
    <%= f.text_area :focus_areas, rows: 3, class: "input", placeholder: "e.g. System design, client communication" %>
  </div>
  <div class="flex justify-end gap-2">
    <%= link_to "Cancel", (@developer ? developer_path(@developer) : growth_plans_path), class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
