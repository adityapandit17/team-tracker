<% content_for :page_title, @developer ? "#{@developer.name} — Growth plans" : "Growth plans" %>
<% content_for :page_description, "Goals, focus areas, and review cadence" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-wrap gap-2">
    <% if @developer %>
      <%= link_to "← #{@developer.name}", @developer, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
    <% else %>
      <%= link_to "All", growth_plans_path, class: params[:status].blank? ? "chip-active" : "chip" %>
      <% GrowthPlan.statuses.keys.each do |s| %>
        <%= link_to s.humanize, growth_plans_path(status: s), class: params[:status] == s ? "chip-active" : "chip" %>
      <% end %>
    <% end %>
  </div>
  <% if can?(:manage_growth_plans) %>
    <%= link_to "+ New plan", (@developer ? new_developer_growth_plan_path(@developer) : new_growth_plan_path), class: "btn-primary" %>
  <% end %>
</div>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  <% @growth_plans.each do |plan| %>
    <article class="card p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <% unless @developer %><p class="text-xs font-semibold uppercase text-ink-400"><%= plan.developer.name %></p><% end %>
          <h3 class="mt-1 font-display text-lg font-semibold"><%= link_to plan.title, plan, class: "hover:text-accent-700" %></h3>
        </div>
        <%= status_badge(plan.status) %>
      </div>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <% if plan.target_career_level.present? %><%= status_badge(plan.target_career_level) %><% end %>
        <% if plan.next_review_on %>
          <span class="<%= plan.overdue? ? 'font-semibold text-red-600' : 'text-ink-500' %>">Review <%= l(plan.next_review_on) %></span>
        <% end %>
      </div>
      <% if plan.goals.present? %><p class="mt-3 line-clamp-3 text-sm text-ink-600"><%= plan.goals %></p><% end %>
    </article>
  <% end %>
  <% if @growth_plans.empty? %>
    <div class="card col-span-full p-10 text-center text-ink-400">No growth plans yet.</div>
  <% end %>
</div>
