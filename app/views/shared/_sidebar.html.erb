<aside class="hidden w-64 shrink-0 flex-col border-r border-ink-200/70 bg-white/55 backdrop-blur-md md:flex">
  <div class="flex h-16 items-center gap-2.5 border-b border-ink-200/70 px-5">
    <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-ink-950 font-display text-sm font-bold text-sand-50 shadow-soft">T</div>
    <div>
      <span class="block font-display text-lg font-semibold leading-none tracking-tight text-ink-950">Team Tracker</span>
      <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-400">Resource ops</span>
    </div>
  </div>
  <nav class="flex-1 space-y-1 p-3">
    <%= render "shared/nav_links" %>
  </nav>
  <div class="border-t border-ink-200/70 p-4">
    <% if user_signed_in? %>
      <div class="mb-3">
        <p class="truncate text-sm font-semibold text-ink-900"><%= current_user.display_name %></p>
        <p class="text-[11px] font-semibold uppercase tracking-wide text-ink-400"><%= current_user.role.humanize %></p>
      </div>
      <div class="flex flex-col gap-1">
        <%= link_to "Account", edit_user_registration_path, class: "text-xs font-semibold text-accent-700 hover:text-accent-900" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-left text-xs font-semibold text-ink-500 hover:text-ink-800" %>
      </div>
    <% else %>
      <p class="text-xs leading-relaxed text-ink-500">Developers, projects, skills &amp; client leads in one place.</p>
    <% end %>
  </div>
</aside>
