<% content_for :page_title, "Bench & allocations" %>
<% content_for :page_description, "Who’s free vs assigned — under #{Developer::BENCH_THRESHOLD_PCT}% is bench" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-wrap items-center gap-2">
    <%= form_with url: bench_path, method: :get, class: "flex items-center gap-2", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
      <label class="text-xs font-semibold uppercase text-ink-500">As of</label>
      <%= date_field_tag :as_of, @as_of, class: "input !w-auto !py-1.5 text-xs" %>
    <% end %>
    <%= link_to "All allocations", allocations_path, class: "chip" %>
    <%= link_to "Active only", allocations_path(active: "1"), class: "chip" %>
    <%= link_to "Utilization", utilization_index_path, class: "chip" if can?(:view_utilization) %>
  </div>
  <% if can?(:manage_allocations) %>
    <%= link_to "+ Add allocation", new_allocation_path, class: "btn-primary" %>
  <% end %>
</div>

<div class="mb-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <div class="card p-4">
    <p class="text-[11px] font-semibold uppercase text-ink-400">On bench</p>
    <p class="stat-value text-2xl"><%= @bench.size %></p>
  </div>
  <div class="card p-4">
    <p class="text-[11px] font-semibold uppercase text-ink-400">Allocated</p>
    <p class="stat-value text-2xl"><%= @allocated.size %></p>
  </div>
  <div class="card p-4">
    <p class="text-[11px] font-semibold uppercase text-ink-400">Bench hours</p>
    <p class="stat-value text-2xl"><%= hours_label(@bench.sum { |r| Allocation::STANDARD_MONTHLY_HOURS - r[:hours] }) %></p>
  </div>
  <div class="card p-4">
    <p class="text-[11px] font-semibold uppercase text-ink-400">Allocated hours</p>
    <p class="stat-value text-2xl"><%= hours_label(@allocated.sum { |r| r[:hours] }) %></p>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  <section class="card p-5">
    <h2 class="font-display text-lg font-semibold text-ink-950">Bench (&lt; <%= Developer::BENCH_THRESHOLD_PCT %>%)</h2>
    <ul class="mt-4 space-y-2">
      <% @bench.each do |row| %>
        <li class="rounded-xl border border-amber-100 bg-amber-50/40 px-3 py-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-2">
              <%= initials_avatar(row[:developer].name, size: "h-8 w-8") %>
              <div>
                <%= link_to row[:developer].name, row[:developer], class: "text-sm font-semibold hover:text-accent-700" %>
                <p class="text-[11px] text-ink-400"><%= row[:developer].stack.upcase %> · <%= row[:pct] %>% · <%= hours_label(row[:hours]) %></p>
              </div>
            </div>
            <%= link_to "+ Allocate", new_developer_allocation_path(row[:developer]), class: "text-xs font-semibold text-accent-700" if can?(:manage_allocations) %>
          </div>
          <% if row[:allocations].any? %>
            <p class="mt-2 text-xs text-ink-500"><%= row[:allocations].map { |a| "#{a.project.name} (#{a.allocation_pct}%)" }.join(" · ") %></p>
          <% end %>
        </li>
      <% end %>
      <% if @bench.empty? %>
        <li class="text-sm text-ink-400">Nobody on bench — fully staffed.</li>
      <% end %>
    </ul>
  </section>

  <section class="card p-5">
    <h2 class="font-display text-lg font-semibold text-ink-950">Allocated</h2>
    <ul class="mt-4 space-y-2">
      <% @allocated.each do |row| %>
        <li class="rounded-xl border border-ink-100 bg-white/70 px-3 py-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-2">
              <%= initials_avatar(row[:developer].name, size: "h-8 w-8") %>
              <div>
                <%= link_to row[:developer].name, row[:developer], class: "text-sm font-semibold hover:text-accent-700" %>
                <p class="text-[11px] text-ink-400"><%= row[:pct] %>% · <%= hours_label(row[:hours]) %></p>
              </div>
            </div>
            <div class="h-2 w-20 overflow-hidden rounded-full bg-ink-100">
              <div class="h-full rounded-full bg-accent-500" style="width: <%= [row[:pct], 100].min %>%"></div>
            </div>
          </div>
          <p class="mt-2 text-xs text-ink-500"><%= row[:allocations].map { |a| "#{a.project.name} (#{a.allocation_pct}%)" }.join(" · ") %></p>
        </li>
      <% end %>
      <% if @allocated.empty? %>
        <li class="text-sm text-ink-400">No allocations yet.</li>
      <% end %>
    </ul>
  </section>
</div>
