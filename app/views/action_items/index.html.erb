<% content_for :page_title, @developer ? "#{@developer.name} — Action Items" : "My Todos" %>
<% content_for :page_description, @developer ? "Action items for this developer" : "Personal todos and team action items" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex flex-wrap items-center gap-2">
    <% if @developer %>
      <%= link_to "← #{@developer.name}", @developer, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
    <% else %>
      <%= link_to "All", action_items_path(view: @view), class: (params[:mine].blank? && params[:personal].blank? && params[:status].blank?) ? "chip-active" : "chip" %>
      <%= link_to "Mine", action_items_path(view: @view, mine: "1"), class: params[:mine] == "1" ? "chip-active" : "chip" %>
      <%= link_to "Personal", action_items_path(view: @view, personal: "1"), class: params[:personal] == "1" ? "chip-active" : "chip" %>
      <% ActionItem.statuses.keys.each do |s| %>
        <%= link_to s.humanize, action_items_path(view: @view, status: s), class: params[:status] == s ? "chip-active" : "chip" %>
      <% end %>
    <% end %>
    <div class="flex rounded-lg border border-ink-200 bg-white/80 p-0.5">
      <%= link_to "Kanban", (@developer ? developer_action_items_path(@developer, view: "kanban") : action_items_path(request.query_parameters.merge(view: "kanban"))),
            class: "rounded-md px-3 py-1 text-xs font-semibold #{@view == 'kanban' ? 'bg-ink-950 text-sand-50' : 'text-ink-600'}" %>
      <%= link_to "Grid", (@developer ? developer_action_items_path(@developer, view: "grid") : action_items_path(request.query_parameters.merge(view: "grid"))),
            class: "rounded-md px-3 py-1 text-xs font-semibold #{@view == 'grid' ? 'bg-ink-950 text-sand-50' : 'text-ink-600'}" %>
    </div>
  </div>
  <%= link_to "+ Add Item",
        (@developer ? new_developer_action_item_path(@developer) : new_action_item_path),
        class: "btn-primary" %>
</div>

<% if @view == "kanban" %>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3" data-controller="kanban">
    <% ActionItem.statuses.keys.each do |status| %>
      <section
        class="rounded-2xl border border-ink-200/70 bg-ink-50/40 p-3 transition"
        data-status="<%= status %>"
        data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop">
        <div class="mb-3 flex items-center justify-between px-1">
          <h3 class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-500"><%= status.humanize %></h3>
          <span class="badge bg-white text-ink-600 ring-1 ring-ink-200"><%= @grouped[status].size %></span>
        </div>
        <div class="min-h-[12rem] space-y-2" data-kanban-list>
          <% @grouped[status].each do |item| %>
            <%= render "action_items/card", item: item %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[800px]">
        <thead class="bg-ink-50/80">
          <tr>
            <th class="table-head">Title</th>
            <th class="table-head">Developer</th>
            <th class="table-head">Assignee</th>
            <th class="table-head">Priority</th>
            <th class="table-head">Status</th>
            <th class="table-head">Due</th>
            <th class="table-head"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100 bg-white/50">
          <% @action_items.each do |item| %>
            <tr class="transition hover:bg-accent-50/40">
              <td class="table-cell font-medium text-ink-950"><%= link_to item.title, item, class: "hover:text-accent-700" %></td>
              <td class="table-cell"><%= item.developer ? link_to(item.developer.name, item.developer, class: "hover:text-accent-700") : content_tag(:span, "Personal", class: "text-ink-400") %></td>
              <td class="table-cell text-ink-500"><%= item.assignee.display_name %></td>
              <td class="table-cell"><%= status_badge(item.priority) %></td>
              <td class="table-cell"><%= status_badge(item.status) %></td>
              <td class="table-cell text-ink-500"><%= item.due_on ? l(item.due_on) : "—" %></td>
              <td class="table-cell text-right">
                <%= link_to "Edit", edit_action_item_path(item), class: "text-xs font-semibold text-accent-700" %>
              </td>
            </tr>
          <% end %>
          <% if @action_items.empty? %>
            <tr><td colspan="7" class="table-cell py-10 text-center text-ink-400">No action items yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
