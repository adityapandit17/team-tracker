<% content_for :page_title, @action_item.title %>
<% content_for :page_description, @action_item.personal? ? "Personal todo" : "Action item · #{@action_item.developer.name}" %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <%= link_to "← My Todos", action_items_path, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Edit", edit_action_item_path(@action_item), class: "btn-secondary" %>
    <%= button_to "Delete", action_item_path(@action_item), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Delete this item?" } } %>
  </div>
</div>

<div class="mx-auto max-w-2xl">
  <article class="card p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h2 class="font-display text-2xl font-semibold text-ink-950"><%= @action_item.title %></h2>
      <div class="flex gap-2">
        <%= status_badge(@action_item.priority) %>
        <%= status_badge(@action_item.status) %>
      </div>
    </div>

    <dl class="mt-5 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-ink-400">Developer</dt>
        <dd class="mt-1 font-medium text-ink-900">
          <% if @action_item.developer %>
            <%= link_to @action_item.developer.name, @action_item.developer, class: "hover:text-accent-700" %>
          <% else %>
            Personal
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-ink-400">Assignee</dt>
        <dd class="mt-1 font-medium text-ink-900"><%= @action_item.assignee.display_name %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-ink-400">Due</dt>
        <dd class="mt-1 font-medium text-ink-900"><%= @action_item.due_on ? l(@action_item.due_on) : "—" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-ink-400">Created by</dt>
        <dd class="mt-1 font-medium text-ink-900"><%= @action_item.created_by.display_name %></dd>
      </div>
    </dl>

    <% if @action_item.description.present? %>
      <div class="mt-6 whitespace-pre-wrap rounded-xl bg-ink-50 p-4 text-sm leading-relaxed text-ink-700"><%= @action_item.description %></div>
    <% end %>
  </article>
</div>
