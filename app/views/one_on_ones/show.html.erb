<% content_for :page_title, "1:1 · #{l(@one_on_one.meeting_on)}" %>
<% content_for :page_description, @one_on_one.developer.name %>

<div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <%= link_to "← All 1:1s", one_on_ones_path, class: "text-sm font-medium text-ink-500 hover:text-ink-800" %>
  <div class="flex flex-wrap gap-2">
    <% if can?(:manage_one_on_ones) && (can?(:manage_all_records) || owns_record?(@one_on_one)) %>
      <%= link_to "Edit", edit_one_on_one_path(@one_on_one), class: "btn-secondary" %>
      <%= button_to "Delete", one_on_one_path(@one_on_one), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Delete this 1:1?" } } %>
    <% end %>
  </div>
</div>

<div class="mx-auto max-w-3xl space-y-4">
  <article class="card p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-400"><%= link_to @one_on_one.developer.name, @one_on_one.developer, class: "hover:text-accent-700" %></p>
        <h2 class="mt-1 font-display text-2xl font-semibold text-ink-950"><%= l(@one_on_one.meeting_on) %></h2>
        <div class="mt-2 flex flex-wrap gap-2">
          <%= status_badge(@one_on_one.status) %>
          <span class="text-xs text-ink-400">with <%= @one_on_one.conductor.display_name %></span>
        </div>
      </div>
      <div class="text-right text-sm">
        <p class="text-[11px] font-semibold uppercase text-ink-400">Next review</p>
        <p class="font-medium <%= @one_on_one.overdue_review? ? 'text-red-600' : 'text-ink-900' %>">
          <%= @one_on_one.next_review_on ? l(@one_on_one.next_review_on) : "—" %>
        </p>
      </div>
    </div>

    <dl class="mt-5 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold uppercase text-ink-400">Growth plan</dt>
        <dd class="mt-1"><%= @one_on_one.growth_plan ? link_to(@one_on_one.growth_plan.title, @one_on_one.growth_plan, class: "font-medium text-accent-700") : "—" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase text-ink-400">Assessment</dt>
        <dd class="mt-1"><%= @one_on_one.assessment ? link_to(@one_on_one.assessment.title, @one_on_one.assessment, class: "font-medium text-accent-700") : "—" %></dd>
      </div>
    </dl>

    <% if @one_on_one.goals.present? %>
      <div class="mt-5">
        <h3 class="text-sm font-semibold text-ink-900">Goals</h3>
        <p class="mt-2 whitespace-pre-wrap text-sm text-ink-700"><%= @one_on_one.goals %></p>
      </div>
    <% end %>
    <% if @one_on_one.notes.present? %>
      <div class="mt-5 rounded-xl bg-ink-50 p-4 text-sm text-ink-700 whitespace-pre-wrap"><%= @one_on_one.notes %></div>
    <% end %>
  </article>

  <section class="card p-6">
    <div class="flex items-center justify-between">
      <h3 class="font-display text-lg font-semibold text-ink-950">Linked action items</h3>
      <%= link_to "My Todos", action_items_path, class: "text-xs font-semibold text-accent-700" %>
    </div>
    <% if @linked_action_items.any? %>
      <ul class="mt-4 space-y-2">
        <% @linked_action_items.each do |item| %>
          <li class="flex items-center justify-between rounded-xl border border-ink-100 px-3 py-2.5 text-sm">
            <%= link_to item.title, item, class: "font-medium hover:text-accent-700" %>
            <div class="flex gap-1.5"><%= status_badge(item.priority) %><%= status_badge(item.status) %></div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-ink-400">No action items linked yet.</p>
    <% end %>
  </section>
</div>
